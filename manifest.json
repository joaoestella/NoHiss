{
  "manifest_version": 3,
  "name": "NoHiss — Tab Noise Remover",
  "short_name": "NoHiss",
  "version": "1.0.0",
  "description": "Removes hiss and background noise from any tab's audio (livestreams, videos, classes) in real time, with RNNoise.",
  "minimum_chrome_version": "116",
  "permissions": ["tabCapture", "offscreen", "storage"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "NoHiss",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
